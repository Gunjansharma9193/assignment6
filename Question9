
using System;
using System.Data;
using System.Data.SqlClient;

class Program
{
    static void Main()
    {
        // Database connection string
        string conStr = @"Data Source=.\SQLEXPRESS;
                          Initial Catalog=CollegeDB;
                          Integrated Security=True";

        try
        {
            // Create SQL connection
            SqlConnection con = new SqlConnection(conStr);

            // Select query
            string query = "SELECT * FROM Student";

            // Create SqlDataAdapter
            SqlDataAdapter da = new SqlDataAdapter(query, con);

            // Create SqlCommandBuilder
            SqlCommandBuilder cb = new SqlCommandBuilder(da);

            // Create DataSet
            DataSet ds = new DataSet();

            // Fill DataSet
            da.Fill(ds, "Student");

            // Get DataTable
            DataTable dt = ds.Tables["Student"];

            // Set primary key
            dt.PrimaryKey = new DataColumn[]
            {
                dt.Columns["Id"]
            };

            int choice;

            do
            {
                Console.WriteLine("\n--- STUDENT MANAGEMENT ---");
                Console.WriteLine("1. Insert Student");
                Console.WriteLine("2. Update Student");
                Console.WriteLine("3. Delete Student");
                Console.WriteLine("4. Display Students");
                Console.WriteLine("5. Exit");

                Console.Write("Enter your choice: ");
                choice = Convert.ToInt32(Console.ReadLine());

                switch (choice)
                {
                    case 1:
                        // INSERT operation
                        DataRow newRow = dt.NewRow();

                        Console.Write("Enter Student ID: ");
                        newRow["Id"] = Convert.ToInt32(Console.ReadLine());

                        Console.Write("Enter Student Name: ");
                        newRow["Name"] = Console.ReadLine();

                        Console.Write("Enter Age: ");
                        newRow["Age"] = Convert.ToInt32(Console.ReadLine());

                        Console.Write("Enter Course: ");
                        newRow["Course"] = Console.ReadLine();

                        dt.Rows.Add(newRow);

                        da.Update(ds, "Student");

                        Console.WriteLine("Record Inserted Successfully!");
                        break;

                    case 2:
                        // UPDATE operation
                        Console.Write("Enter Student ID to Update: ");
                        int updateId = Convert.ToInt32(Console.ReadLine());

                        DataRow updateRow = dt.Rows.Find(updateId);

                        if (updateRow != null)
                        {
                            Console.Write("Enter New Name: ");
                            updateRow["Name"] = Console.ReadLine();

                            Console.Write("Enter New Age: ");
                            updateRow["Age"] = Convert.ToInt32(Console.ReadLine());

                            Console.Write("Enter New Course: ");
                            updateRow["Course"] = Console.ReadLine();

                            da.Update(ds, "Student");

                            Console.WriteLine("Record Updated Successfully!");
                        }
                        else
                        {
                            Console.WriteLine("Student ID Not Found!");
                        }
                        break;

                    case 3:
                        // DELETE operation
                        Console.Write("Enter Student ID to Delete: ");
                        int deleteId = Convert.ToInt32(Console.ReadLine());

                        DataRow deleteRow = dt.Rows.Find(deleteId);

                        if (deleteRow != null)
                        {
                            deleteRow.Delete();

                            da.Update(ds, "Student");

                            Console.WriteLine("Record Deleted Successfully!");
                        }
                        else
                        {
                            Console.WriteLine("Student ID Not Found!");
                        }
                        break;

                    case 4:
                        // DISPLAY operation
                        Console.WriteLine("\nStudent Records:");

                        foreach (DataRow row in dt.Rows)
                        {
                            if (row.RowState != DataRowState.Deleted)
                            {
                                Console.WriteLine(
                                    "ID: " + row["Id"] +
                                    ", Name: " + row["Name"] +
                                    ", Age: " + row["Age"] +
                                    ", Course: " + row["Course"]);
                            }
                        }
                        break;

                    case 5:
                        Console.WriteLine("Program Exited!");
                        break;

                    default:
                        Console.WriteLine("Invalid Choice!");
                        break;
                }

            } while (choice != 5);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error: " + ex.Message);
        }
    }
}
