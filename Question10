CREATE DATABASE CollegeDB;

USE CollegeDB;

CREATE TABLE Student
(
    Id INT PRIMARY KEY,
    Name VARCHAR(50),
    Age INT,
    Course VARCHAR(50)
);

INSERT INTO Student VALUES
(101, 'Gunjan', 22, 'MCA'),
(102, 'Rahul', 23, 'BCA'),
(103, 'Priya', 22, 'MCA');

SELECT * FROM Student;



using System;
using System.Data.SqlClient;

class Program
{
    static void Main()
    {
        string conStr = @"Data Source=.\SQLEXPRESS;
                          Initial Catalog=CollegeDB;
                          Integrated Security=True";

        SqlConnection con = new SqlConnection(conStr);

        try
        {
            con.Open();

            Console.WriteLine("Database Connected Successfully!");

            int choice;

            do
            {
                Console.WriteLine("\n--- CONNECTED CRUD ---");
                Console.WriteLine("1. Insert Student");
                Console.WriteLine("2. Display Students");
                Console.WriteLine("3. Update Student");
                Console.WriteLine("4. Delete Student");
                Console.WriteLine("5. Exit");

                Console.Write("Enter Choice: ");
                choice = Convert.ToInt32(Console.ReadLine());

                switch (choice)
                {
                    case 1:
                        Console.Write("Enter ID: ");
                        int id = Convert.ToInt32(Console.ReadLine());

                        Console.Write("Enter Name: ");
                        string name = Console.ReadLine();

                        Console.Write("Enter Age: ");
                        int age = Convert.ToInt32(Console.ReadLine());

                        Console.Write("Enter Course: ");
                        string course = Console.ReadLine();

                        string insert = "INSERT INTO Student " +
                            "(Id, Name, Age, Course) " +
                            "VALUES (@Id, @Name, @Age, @Course)";

                        SqlCommand cmd1 = new SqlCommand(insert, con);

                        cmd1.Parameters.AddWithValue("@Id", id);
                        cmd1.Parameters.AddWithValue("@Name", name);
                        cmd1.Parameters.AddWithValue("@Age", age);
                        cmd1.Parameters.AddWithValue("@Course", course);

                        cmd1.ExecuteNonQuery();

                        Console.WriteLine("Record Inserted Successfully!");
                        break;

                    case 2:
                        string select = "SELECT * FROM Student";

                        SqlCommand cmd2 = new SqlCommand(select, con);

                        SqlDataReader dr = cmd2.ExecuteReader();

                        Console.WriteLine("\nStudent Records:");

                        while (dr.Read())
                        {
                            Console.WriteLine(
                                dr["Id"] + " " +
                                dr["Name"] + " " +
                                dr["Age"] + " " +
                                dr["Course"]);
                        }

                        dr.Close();
                        break;

                    case 3:
                        Console.Write("Enter ID to Update: ");
                        int uid = Convert.ToInt32(Console.ReadLine());

                        Console.Write("Enter New Name: ");
                        string uname = Console.ReadLine();

                        Console.Write("Enter New Age: ");
                        int uage = Convert.ToInt32(Console.ReadLine());

                        Console.Write("Enter New Course: ");
                        string ucourse = Console.ReadLine();

                        string update = "UPDATE Student SET " +
                            "Name=@Name, Age=@Age, Course=@Course " +
                            "WHERE Id=@Id";

                        SqlCommand cmd3 = new SqlCommand(update, con);

                        cmd3.Parameters.AddWithValue("@Id", uid);
                        cmd3.Parameters.AddWithValue("@Name", uname);
                        cmd3.Parameters.AddWithValue("@Age", uage);
                        cmd3.Parameters.AddWithValue("@Course", ucourse);

                        int r1 = cmd3.ExecuteNonQuery();

                        Console.WriteLine(r1 > 0 ?
                            "Record Updated Successfully!" :
                            "Student ID Not Found!");
                        break;

                    case 4:
                        Console.Write("Enter ID to Delete: ");
                        int did = Convert.ToInt32(Console.ReadLine());

                        string delete = "DELETE FROM Student WHERE Id=@Id";

                        SqlCommand cmd4 = new SqlCommand(delete, con);

                        cmd4.Parameters.AddWithValue("@Id", did);

                        int r2 = cmd4.ExecuteNonQuery();

                        Console.WriteLine(r2 > 0 ?
                            "Record Deleted Successfully!" :
                            "Student ID Not Found!");
                        break;

                    case 5:
                        Console.WriteLine("Program Exited!");
                        break;

                    default:
                        Console.WriteLine("Invalid Choice!");
                        break;
                }

            } while (choice != 5);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error: " + ex.Message);
        }
        finally
        {
            con.Close();
        }
    }
}

